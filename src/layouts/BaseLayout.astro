---
import '../styles/global.css';
import { url } from '../lib/site';
const {title = 'Futpedia FC | O portal do futebol gaúcho', description = 'Histórias, clubes, competições e estádios do futebol gaúcho.'} = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#063923" />
  <title>{title}</title>
</head>
<body>
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
  <header class="site-header">
    <div class="container header-inner">
      <a class="wordmark" href={url('')} aria-label="Futpedia FC, início">
        <span class="mark">FP</span><span><strong>FUTPEDIA FC</strong><small>O PORTAL DO FUTEBOL GAÚCHO</small></span>
      </a>
      <nav class="main-nav" aria-label="Navegação principal">
        <a href={url('')}>Início</a><a href={url('historias/')}>Histórias</a><a href={url('clubes/')}>Clubes</a><a href={url('competicoes/')}>Competições</a><a href={url('estadios/')}>Estádios</a>
      </nav>
    </div>
  </header>
  <main id="conteudo"><slot /></main>
  <footer class="site-footer"><div class="container footer-inner"><strong>FUTPEDIA FC</strong><span>Futebol • Histórias • Estádios</span><small>Protótipo editorial — conteúdo demonstrativo</small></div></footer>
</body>
</html>
