---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import {stories, url} from '../lib/site';
---
<BaseLayout>
  <div class="container homepage">
    <div class="kicker">FUTEBOL GAÚCHO, MEMÓRIA E IDENTIDADE <span>• Portal em construção</span></div>
    <section class="lead-grid" aria-label="Destaques editoriais">
      <FeatureCard {...stories[0]} large />
      <div class="lead-side"><FeatureCard {...stories[1]} /><FeatureCard {...stories[2]} /></div>
      <aside class="latest box">
        <div class="section-heading"><h2>Últimas publicações</h2></div>
        <p class="muted">Estamos preparando as primeiras reportagens sobre o futebol gaúcho.</p>
        <a class="text-link" href={url('historias/')}>Explorar histórias →</a>
      </aside>
    </section>
    <div class="editorial-grid">
      <section class="box">
        <div class="section-heading"><h2>Esquadrões históricos</h2><a href={url('historias/')}>Ver todos →</a></div>
        <div class="mini-grid">
          <a class="mini-card" href={url('historias/')}><span class="mini-art blue"></span><strong>Grandes campanhas</strong><small>Histórias para descobrir</small></a>
          <a class="mini-card" href={url('historias/')}><span class="mini-art red"></span><strong>Ídolos do interior</strong><small>Personagens e memória</small></a>
          <a class="mini-card" href={url('historias/')}><span class="mini-art green"></span><strong>Jogos eternos</strong><small>Partidas que marcaram época</small></a>
        </div>
      </section>
      <section class="box">
        <div class="section-heading"><h2>Competições em destaque</h2><a href={url('competicoes/')}>Ver competições →</a></div>
        <div class="competitions">
          <a class="competition primary" href={url('competicoes/')}>⚽<strong>Gauchão</strong><span>Série A</span></a>
          <a class="competition" href={url('competicoes/')}>⚽<strong>Gauchão</strong><span>Série A2</span></a>
          <a class="competition" href={url('competicoes/')}>⚽<strong>Gauchão</strong><span>Série B</span></a>
        </div>
      </section>
      <section class="box">
        <div class="section-heading"><h2>Futpedia nos Estádios</h2><a href={url('estadios/')}>Ver série →</a></div>
        <a class="stadium-feature" href={url('estadios/')}><span class="video-art" aria-hidden="true">▶</span><span><em>SÉRIE ESPECIAL</em><strong>Conheça os palcos do futebol gaúcho</strong><small>Vlogs, memórias e experiências nos estádios do Rio Grande do Sul.</small></span></a>
      </section>
      <section class="box discover">
        <h2>Explore a Futpedia</h2><p>Um acervo em construção sobre clubes, personagens, competições e estádios do futebol gaúcho.</p>
        <div class="discovery-links"><a href={url('clubes/')}>Clubes ↗</a><a href={url('competicoes/')}>Competições ↗</a><a href={url('estadios/')}>Estádios ↗</a><a href={url('historias/')}>Histórias ↗</a></div>
      </section>
    </div>
  </div>
</BaseLayout>
