---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialGallery from '../../components/EditorialGallery.astro';
import RelatedEditorial from '../../components/RelatedEditorial.astro';
import { getArchive, relatedEditorially } from '../../lib/archive';
import { url } from '../../lib/site';
import '../../styles/article.css';
type Props = { article: CollectionEntry<'articles'> };
export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({ params: { slug: article.id }, props: { article } }));
}
const { article } = Astro.props;
const { Content, headings } = await render(article);
const { articles } = await getArchive();
const related = relatedEditorially(article, articles);
const date = new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long', timeZone: 'UTC' }).format(article.data.publishedAt);
const articleUrl = new URL(url('historias/' + article.id + '/'), Astro.site ?? Astro.url).toString();
const sections = headings.filter((h) => h.depth === 2);
---
<BaseLayout title={article.data.title + ' | Futpedia FC'} description={article.data.description} type="article" canonical={articleUrl}>
  <article class="article-shell">
    <header class="article-heading container">
      <nav class="breadcrumbs" aria-label="Caminho de navegação">
        <a href={url('')}>Início</a><span aria-hidden="true">/</span><a href={url('historias/')}>Histórias</a>
      </nav>
      <p class="article-eyebrow">{article.data.eyebrow}</p>
      <h1>{article.data.title}</h1><p class="article-deck">{article.data.description}</p>
      <div class="article-meta">
        <span>{article.data.author}</span><span aria-hidden="true">·</span>
        <time datetime={article.data.publishedAt.toISOString()}>{date}</time>
        <span aria-hidden="true">·</span><span>{article.data.readingMinutes} min de leitura</span>
      </div>
      {article.data.demo && <p class="demo-note"><strong>Conteúdo demonstrativo:</strong> esta publicação apresenta a experiência editorial do MVP.</p>}
    </header>
    <div class="article-image-wrap container">
      {article.data.cover ? (
        <figure class="article-cover">
          <img src={url(article.data.cover)} alt={article.data.coverAlt} width="1440" height="810" loading="eager" />
          <figcaption>Foto: {article.data.coverCredit} · {article.data.coverLicense}</figcaption>
        </figure>
      ) : (
        <div class="article-cover-placeholder" role="img" aria-label="Ilustração abstrata de um gramado com arquibancadas">
          <span>FUTEBOL • HISTÓRIAS • ESTÁDIOS</span>
        </div>
      )}
    </div>
    <div class="container article-body-grid">
      <aside class="article-sidebar" aria-label="Nesta reportagem">
        <p class="sidebar-title">NESTA REPORTAGEM</p>
        {sections.length > 0 && <nav class="article-toc" aria-label="Sumário do artigo">
          {sections.map((h) => <a href={'#' + h.slug}>{h.text}</a>)}
        </nav>}
      </aside>
      <div class="article-primary">
        {sections.length > 0 && <details class="article-mobile-toc">
          <summary>Ir para uma seção desta matéria</summary>
          <nav aria-label="Sumário para celular">{sections.map((h) => <a href={'#' + h.slug}>{h.text}</a>)}</nav>
        </details>}
        <div class="article-prose"><Content /></div>
        <EditorialGallery images={article.data.gallery} />
        <div class="article-back"><a href={url('historias/')}>← Voltar ao acervo de histórias</a></div>
      </div>
    </div>
  </article>
  <RelatedEditorial articles={related} />
</BaseLayout>
